VITE_API_BASE_URL=/api
# Demo is opt-in for the retained Company demo repository only.
VITE_DEMO_MODE=false

# Server only. Never prefix secrets with VITE_.
KONEPS_SERVICE_KEY=
# preserve: keep the key exactly as issued (mona-live raw/decoded/already_encoded).
# encode: URL-encode an unencoded key once.
KONEPS_SERVICE_KEY_MODE=preserve
